{
  "family": "lp-sync-notion",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/lp-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/lp-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "sync",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/lp-internal/sync:latest",
      "essential": true,
      "command": [
        "/bin/sh", "-c",
        "cd /workspace/connectors/notion && node dist/cli.js"
      ],
      "environment": [
        { "name": "NODE_ENV",           "value": "production" },
        { "name": "USE_AWS_SECRETS",    "value": "true" },
        { "name": "AWS_REGION",         "value": "us-east-1" },
        { "name": "AWS_SECRETS_PREFIX", "value": "lp-internal" }
      ],
      "secrets": [
        { "name": "DATABASE_URL",                    "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:lp-internal/db:DATABASE_URL::" },
        { "name": "NOTION_API_KEY",                  "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:lp-internal/notion:NOTION_API_KEY::" },
        { "name": "NOTION_MEETING_TRANSCRIPTS_DB_ID","valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:lp-internal/notion:NOTION_MEETING_TRANSCRIPTS_DB_ID::" },
        { "name": "OPENAI_API_KEY",                  "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:lp-internal/openai:OPENAI_API_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lp-sync-notion",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
