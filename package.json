{
  "name": "lp-internal-ai-v1",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @lp-ai/hq dev",
    "db:generate": "pnpm --filter @lp-ai/lib-db generate",
    "db:migrate": "pnpm --filter @lp-ai/lib-db migrate",
    "db:studio": "pnpm --filter @lp-ai/lib-db studio",
    "db:push": "pnpm --filter @lp-ai/lib-db push",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "sync:drive": "pnpm --filter @lp-ai/connector-google-drive sync",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "googleapis": "^140.0.1",
    "prettier": "^3.3.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
