{
  "name": "lp-internal-ai-v1",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "db:generate": "pnpm --filter @lp-ai/lib-db generate",
    "db:migrate": "pnpm --filter @lp-ai/lib-db migrate",
    "db:studio": "pnpm --filter @lp-ai/lib-db studio",
    "db:push": "pnpm --filter @lp-ai/lib-db push",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @lp-ai/lib-db seed",
    "sync:sheets": "pnpm --filter @lp-ai/connector-google-sheets sync",
    "sync:drive": "pnpm --filter @lp-ai/connector-google-drive sync",
    "sync:aplos": "pnpm --filter @lp-ai/connector-aplos sync",
    "sync:notion": "pnpm --filter @lp-ai/connector-notion sync",
    "sync:slack": "pnpm --filter @lp-ai/connector-slack sync",
    "sync:all": "pnpm --filter \"@lp-ai/connector-*\" --parallel sync",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
