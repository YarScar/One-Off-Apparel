{
  "name": "@lp-ai/mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file=../../.env --watch dist/index.js",
    "dev:http": "node --env-file=../../.env --watch dist/serve-http.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/serve-http.js",
    "start:bridge": "node dist/bridge.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lp-ai/connector-google-drive": "workspace:*",
    "@lp-ai/lib-config": "workspace:*",
    "@lp-ai/lib-db": "workspace:*",
    "@lp-ai/lib-embedding": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sentry/node": "^10.57.0",
    "jose": "^6.2.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
