# -----------------------------------------------------------------------
# Postgres (AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# -----------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------
# OpenAI (embeddings — text-embedding-3-large)
# -----------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------
# AWS
# Profile used for local dev (maps to ~/.aws/credentials)
# In production, App Runner uses the attached IAM role — no key needed.
# -----------------------------------------------------------------------
AWS_PROFILE=lp-internal
AWS_REGION=us-east-1

# -----------------------------------------------------------------------
# AWS Secrets Manager
# Set to "true" in production; "false" for local dev (falls back to .env)
# -----------------------------------------------------------------------
USE_AWS_SECRETS=false
AWS_SECRETS_PREFIX=lp-internal

# -----------------------------------------------------------------------
# Google (Drive + Sheets)
# Base64-encoded contents of the service account JSON file:
#   base64 -i path/to/service-account.json | tr -d '\n'
# -----------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Comma-separated "id:Name" pairs for standalone Google Doc ingestion.
# All tabs of each doc are extracted; every doc becomes chunks in document_chunks.
# Example: 1YYEsi0PWm0oCtKAG_8jyQuP2PFEOhovnFroxkVeJ-WI:Launchpad Prospecting Criteria MASTER
GOOGLE_DOC_IDS=

# -----------------------------------------------------------------------
# Google Sheets — data sources
# IDs are the long alphanumeric strings in each sheet's URL.
# -----------------------------------------------------------------------
# V2 Student Information sheet — source-of-truth for Students + PhaseCompletion + Employment.
# The legacy sheet (GOOGLE_SHEETS_STUDENT_INFO_ID) was retired 2026-08-24; it had been the source
# for the Certifications tab, which has no replacement on V2 yet — syncCertifications() no-ops.
GOOGLE_SHEETS_STUDENT_INFO_V2=
GOOGLE_SHEETS_DASHBOARD_ID=
GOOGLE_SHEETS_PHASE_DASHBOARD_ID=
GOOGLE_SHEETS_BY_PHASE_Q3_2026_ACTUALS=
GOOGLE_SHEETS_BUDGET_BY_PHASE_ACTUALS_2025=
GOOGLE_SHEETS_RAPID=
GOOGLE_SHEETS_PEX=
GOOGLE_SHEETS_STUDENT_COMPETENCY=
GOOGLE_SHEETS_DEVELOPMENT_CRM=
GOOGLE_SHEETS_ATTENDANCE_COHORT_1=
GOOGLE_SHEETS_ATTENDANCE_COHORT_2=
GOOGLE_SHEETS_ATTENDANCE_COHORT_3=
GOOGLE_SHEETS_ATTENDANCE_COHORT_4=
# Quote Bank spreadsheet — rows are embedded into document_chunks for grant-writing retrieval.
# Example: 1Yuj3jvp0095TvmRLU61-W6ChdcFuM2DWHDwnVT0X3uc
GOOGLE_SHEETS_QUOTE_BANK_ID=

# -----------------------------------------------------------------------
# BigQuery (source connector — read-only)
# -----------------------------------------------------------------------
BIGQUERY_PROJECT_ID=lp-internal-ai
BIGQUERY_DATASET=

# -----------------------------------------------------------------------
# Aplos (nonprofit accounting)
# -----------------------------------------------------------------------
APLOS_CLIENT_ID=
APLOS_API_KEY=

# -----------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------
# Notion
# -----------------------------------------------------------------------
NOTION_API_KEY=
NOTION_MEETING_TRANSCRIPTS_DB_ID=
# Comma-separated "id:Name" pairs for generic DB sync (everything except Meetings)
# Example: 3b8bc9382180808b9c97e1b81d204f07:Grants Tracker
NOTION_SYNC_DATABASE_IDS=
# Comma-separated "id:Name" pairs for standalone page sync (root pages; subpages
# reached via child_page blocks are ingested recursively up to depth 4)
# Example: 38bbc93821808106859be8c4cf05b580:Grant Writing Playbook, 38bbc9382180810ca164d02645fd379c:Content Blocks
NOTION_SYNC_PAGE_IDS=

# -----------------------------------------------------------------------
# NextAuth (HQ dashboard)
# -----------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAIN=launchpadphilly.org

# -----------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------
SENTRY_DSN_HQ=
SENTRY_DSN_MCP=
SENTRY_ORG=
SENTRY_PROJECT_HQ=lp-internal-hq
SENTRY_PROJECT_MCP=lp-internal-mcp

# -----------------------------------------------------------------------
# EventBridge sync auth (shared secret between EventBridge Lambda + App Runner)
# -----------------------------------------------------------------------
SYNC_SECRET=

# -----------------------------------------------------------------------
# Claude Code telemetry ingestion (shared bearer token — set the same value in
# claude.ai/admin-settings/claude-code as OTEL_EXPORTER_OTLP_HEADERS)
# -----------------------------------------------------------------------
CLAUDE_TELEMETRY_SHARED_TOKEN=

# -----------------------------------------------------------------------
# OpenProject (work tracking — every change here needs a work package)
# Auth is HTTP Basic with the literal username "apikey" and the key as password.
# Generate a key at <instance>/my/access_token. See CLAUDE.md § Work Tracking.
# -----------------------------------------------------------------------
OPENPROJECT_URL=https://projects.liftofflearning.tech
OPENPROJECT_PROJECT_ID=internal-ai-integrations
OPENPROJECT_API_KEY=
