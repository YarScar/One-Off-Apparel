{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunSyncTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:${AWS_ACCOUNT_ID}:task-definition/lp-sync-*:*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:${AWS_ACCOUNT_ID}:cluster/lp-internal"
        }
      }
    },
    {
      "Sid": "PassEcsTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/lp-ecs-task-role",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/lp-ecs-execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
